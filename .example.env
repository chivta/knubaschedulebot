# Telegram bot token from @BotFather.
BOT_TOKEN=replace

# Telegram user IDs of the admins, comma separated. Admins may always use the
# bot and may add or remove other users with /allow and /deny.
ADMIN_IDS=replace

# Bot API base URL. Tests point it at a fake server.
TELEGRAM_API_URL=https://api.telegram.org

# SQLite file with each user's group and the allow list. Belongs on persistent
# storage in the cluster.
DB_PATH=data/knubaschedulebot.db

# Redis holding cached responses of the schedule site.
REDIS_URL=redis://localhost:6379/0

# How long a cached response is reused before the bot asks the site again.
CACHE_TTL=1h

# The schedule site and the time allowed for one request to it.
MKR_BASE_URL=https://mkr.knuba.edu.ua
MKR_TIMEOUT=20s

# Health and metrics endpoints.
HTTP_ADDR=:8080

# debug | info | warn | error
LOG_LEVEL=info
